# Python / tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# Notebooks: the jupytext .py file is the source of truth; .ipynb is a local view
notebooks/*.ipynb
.ipynb_checkpoints/

# Data: raw data is never committed (fetch it, see data/raw/README.md)
data/raw/*
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Figures are regenerated by the pipeline
reports/figures/*
!reports/figures/.gitkeep

# Local settings / secrets
.env
.DS_Store
.idea/
.vscode/
